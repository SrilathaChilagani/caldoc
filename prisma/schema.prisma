generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Patient {
  id              String            @id @default(cuid())
  name            String
  phone           String            @unique
  email           String?           @unique
  dob             DateTime?
  consentAt       DateTime?
  createdAt       DateTime          @default(now())
  profilePhotoKey String?
  appointments    Appointment[]
  addresses       PatientAddress[]
  documents       PatientDocument[]
  PatientLoginOtp PatientLoginOtp[]
  otps            PatientOtp[]
  labOrders       LabOrder[]
  rxOrders        RxOrder[]
}

model Provider {
  id                 String           @id @default(cuid())
  name               String
  speciality         String
  languages          String[]
  licenseNo          String
  is24x7             Boolean          @default(false)
  slug               String           @unique @db.VarChar(120)
  councilName        String?
  qualification      String?
  registrationNumber String?
  isActive           Boolean          @default(true)
  licenseDocKey      String?
  profilePhotoKey    String?
  registrationDocKey String?
  phone              String?
  defaultFeePaise    Int              @default(100)
  appointments       Appointment[]
  ngoReservations    NgoReservation[]
  users              ProviderUser[]
  slots              Slot[]
}

model Slot {
  id              String           @id @default(cuid())
  providerId      String
  startsAt        DateTime
  endsAt          DateTime
  isBooked        Boolean          @default(false)
  feePaise        Int?
  appointments    Appointment[]
  ngoReservations NgoReservation[]
  provider        Provider         @relation(fields: [providerId], references: [id])

  @@unique([providerId, startsAt])
}

model Appointment {
  id                      String                     @id @default(cuid())
  patientId               String
  patientName             String?
  providerId              String
  slotId                  String?
  status                  String                     @default("PENDING")
  videoRoom               String?
  recordingKey            String?
  paymentId               String?
  deliveryOpt             String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  waError                 String?
  waStatus                String?
  consentAt               DateTime?
  consentMode             String?
  consentText             String?
  consentType             String?
  deliveryAddressId       String?
  deliveryAddressSnapshot Json?
  uploadLinkSentAt        DateTime?
  visitMode               String?                    @default("VIDEO")
  feePaise                Int?
  feeCurrency             String?                    @default("INR")
  deliveryAddress         PatientAddress?            @relation("AppointmentDeliveryAddress", fields: [deliveryAddressId], references: [id])
  patient                 Patient                    @relation(fields: [patientId], references: [id])
  provider                Provider                   @relation(fields: [providerId], references: [id])
  slot                    Slot?                      @relation(fields: [slotId], references: [id])
  statusHistory           AppointmentStatusHistory[]
  ngoReservation          NgoReservation?
  messages                OutboundMessage[]
  patientDocuments        PatientDocument[]
  payment                 Payment?
  PaymentReceipt          PaymentReceipt?
  pharmacyFulfillment     PharmacyFulfillment?
  prescription            Prescription?
  visitNote               VisitNote?
  labOrders               LabOrder[]
}

model Payment {
  id            String       @id @default(cuid())
  gateway       String
  orderId       String       @unique
  paymentRef    String?
  amount        Int
  currency      String       @default("INR")
  status        String
  appointmentId String?      @unique
  rxOrderId     String?      @unique
  labOrderId    String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now())
  receiptUrl    String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  rxOrder       RxOrder?     @relation("RxOrderPayment", fields: [rxOrderId], references: [id])
  labOrder      LabOrder?    @relation("LabOrderPayment", fields: [labOrderId], references: [id])
}

model PatientAddress {
  id           String        @id @default(cuid())
  patientId    String
  label        String?
  contactName  String?
  contactPhone String?
  line1        String
  line2        String?
  city         String
  state        String
  postalCode   String
  instructions String?
  savedAt      DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastUsedAt   DateTime?
  appointments Appointment[] @relation("AppointmentDeliveryAddress")
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([contactPhone])
}

model PatientDocument {
  id            String      @id @default(cuid())
  appointmentId String
  patientId     String
  key           String
  fileName      String
  contentType   String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model PatientOtp {
  id             String    @id @default(cuid())
  patientId      String?
  phoneRaw       String
  phoneCanonical String
  last10         String
  otpHash        String
  expiresAt      DateTime
  attempts       Int       @default(0)
  lastSentAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  usedAt         DateTime?
  patient        Patient?  @relation(fields: [patientId], references: [id])

  @@index([phoneCanonical])
  @@index([last10])
}

model Prescription {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  pdfKey        String
  meds          Json
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorType String
  action    String
  meta      Json
  at        DateTime @default(now())
}

model WebhookEvent {
  id        String   @id @default(cuid())
  source    String
  eventId   String   @unique
  type      String
  orderId   String?
  payload   Json
  createdAt DateTime @default(now())
}

model ProviderUser {
  id           String   @id @default(cuid())
  providerId   String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  provider     Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Ngo {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  contactEmail String?
  contactPhone String?
  description  String?
  isActive     Boolean          @default(true)
  billingNotes String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  reservations NgoReservation[]
  users        NgoUser[]

  @@index([slug])
}

model NgoUser {
  id           String   @id @default(cuid())
  ngoId        String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  ngo          Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
}

model NgoReservation {
  id            String       @id @default(cuid())
  ngoId         String
  providerId    String
  slotId        String?
  appointmentId String?      @unique
  friendlyId    String       @unique
  speciality    String?
  notes         String?
  status        String       @default("HELD")
  amountPaise   Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  confirmedAt   DateTime?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  ngo           Ngo          @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  provider      Provider     @relation(fields: [providerId], references: [id])
  slot          Slot?        @relation(fields: [slotId], references: [id])

  @@index([ngoId, status])
  @@index([providerId, status])
}

model VisitNote {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  text          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model AppointmentStatusHistory {
  id            String      @id @default(cuid())
  appointmentId String
  fromStatus    String
  toStatus      String
  actorType     String
  actorId       String?
  reason        String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

model OutboundMessage {
  id            String      @id @default(cuid())
  appointmentId String
  channel       String
  toPhone       String?
  toEmail       String?
  template      String?
  body          String?
  messageId     String?     @unique
  status        String
  error         String?
  createdAt     DateTime    @default(now())
  kind          String?
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@index([appointmentId, template, status])
  @@index([appointmentId, kind, status])
}

model PharmacyFulfillment {
  id            String       @id @default(cuid())
  status        String       @default("READY")
  notes         String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model LabOrder {
  id            String      @id @default(cuid())
  appointmentId String?
  patientId     String?
  patientName   String?
  patientPhone  String?
  patientEmail  String?
  deliveryMode  String?
  tests         Json?
  notes         String?
  status        String      @default("PENDING")
  address       Json?
  amountPaise   Int?
  source        String      @default("APPOINTMENT")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient       Patient?    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payment       Payment?    @relation("LabOrderPayment")
}

model LabUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("LAB_ADMIN")
  createdAt    DateTime @default(now())
}

model PharmacyUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("PHARMACY")
  createdAt    DateTime @default(now())
}

model RxOrder {
  id           String   @id @default(cuid())
  patientId    String?
  patientName  String
  patientPhone String
  patientEmail String?
  address      Json
  items        Json
  notes        String?
  rxDocumentKey        String?
  rxDocumentName       String?
  rxDocumentType       String?
  rxDocumentSize       Int?
  rxDocumentUploadedAt DateTime?
  amountPaise  Int
  status       String   @default("AWAITING_PAYMENT")
  payment      Payment? @relation("RxOrderPayment")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  patient      Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([patientId])
}

model OfflineRequest {
  id         String    @id @default(cuid())
  name       String
  phone      String
  speciality String?
  notes      String?
  status     String    @default("RECEIVED")
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt DateTime? @db.Timestamptz(6)
}

model PatientLoginOtp {
  phoneKey   String   @id
  patientId  String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  sendCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PaymentReceipt {
  appointmentId String      @id
  key           String
  createdAt     DateTime    @default(now())
  Appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Medication {
  id        String    @id @default(cuid())
  name      String    @unique
  generic   String?
  form      String?
  strength  String?
  category  String?   @default("OTC")
  createdAt DateTime? @default(now()) @db.Timestamp(6)

  @@index([name])
}
