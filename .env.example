# ─────────────────────────────────────────────
# CalDoc Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or .env.local to git.
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_BASE_URL=https://caldoc.in
NEXT_PUBLIC_APP_URL=https://caldoc.in
BASE_URL=https://caldoc.in

# ── Database (Neon) ──────────────────────────
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require
SHADOW_DATABASE_URL=postgresql://<user>:<password>@<host>/<db>_shadow?sslmode=require&channel_binding=require

# ── Auth secrets (generate with: node -e "require('crypto').randomBytes(48).toString('hex')|console.log") ──
JWT_SECRET=<64-char-hex>
APP_SECRET=<64-char-hex>
PROVIDER_CONFIRM_SECRET=<64-char-hex>
PROVIDER_CONFIRM_TTL_MINUTES=1440

# ── Cron auth (set same value in GitHub Actions secret CRON_SECRET and Vercel env) ──
CRON_SECRET=<64-char-hex>

# ── Razorpay ─────────────────────────────────
NEXT_PUBLIC_RZP_KEY_ID=rzp_live_<key>
RZP_KEY_ID=rzp_live_<key>
RZP_KEY=rzp_live_<key>
RZP_KEY_SECRET=<razorpay-secret>
RZP_SECRET=<razorpay-secret>
RZP_WEBHOOK_SECRET=<razorpay-webhook-secret>

# ── WhatsApp / Meta ───────────────────────────
WA_PHONE_NUMBER_ID=<phone-number-id>
WABA_ID=<waba-id>
WHATSAPP_TOKEN=<permanent-access-token>
META_WEBHOOK_VERIFY_TOKEN=<random-string>
META_APP_SECRET=<meta-app-secret>

# WhatsApp language defaults
WHATSAPP_LANG=en_US
WHATSAPP_PATIENT_AUDIO_LANG=en_US
WHATSAPP_PROVIDER_TEMPLATE_LANG=en_US
WHATSAPP_LAB_PATIENT_LANG=en_US
WHATSAPP_LAB_ADMIN_LANG=en_US

# WhatsApp template names (must match Meta Business Manager)
WHATSAPP_TEMPLATE_PATIENT_LOGIN=patient_login_otp
WHATSAPP_TMPL_PATIENT_BOOKING_ALERT=patient_booking_alert
WHATSAPP_TMPL_CHECKIN=appointment_checkin
WHATSAPP_TMPL_CONFIRM=appointment_confirm
WHATSAPP_TMPL_COMPLETE=appointment_complete
WHATSAPP_TMPL_CANCEL=appointment_cancel
WHATSAPP_TMPL_NO_SHOW=appointment_no_show
WHATSAPP_TMPL_RESCHEDULE=appointment_reschedule
WHATSAPP_PROVIDER_TEMPLATE=provider_appointment_template
WHATSAPP_TMPL_PATIENT_AUDIO_CONFIRM=appointment_audio_confirm
WHATSAPP_TMPL_PATIENT_VIDEO_LINK=patient_video
WHATSAPP_TMPL_PROVIDER_VIDEO_LINK=provider_video
WHATSAPP_TMPL_PATIENT_VIDEO_24=appointment_reminder_24h
WHATSAPP_TMPL_PATIENT_VIDEO_10=appointment_reminder_10m
WHATSAPP_TMPL_PATIENT_VIDEO_REMINDER=patient_video
WHATSAPP_TMPL_PROVIDER_VIDEO_ALERT=provider_video
WHATSAPP_TMPL_PROVIDER_REMINDER_24H=provider_reminder_24h
WHATSAPP_TMPL_PROVIDER_REMINDER_10M=provider_reminder_10m
WHATSAPP_TMPL_UPLOAD=whatsapp_upload_template
WHATSAPP_TMPL_PHARMACY_STATUS=pharmacy_status
WHATSAPP_TMPL_LAB_PATIENT_CONFIRM=lab_order_confirm
WHATSAPP_TMPL_LAB_ADMIN_ALERT=lab_order_admin_alert
PATIENT_AUDIO_FALLBACK_TEXT="Hi {patient}, Dr. {provider} will call you around {time}. Track your visit: {portal}"

# ── Daily.co (video) ─────────────────────────
DAILY_DOMAIN=<your-subdomain>.daily.co
NEXT_PUBLIC_DAILY_DOMAIN=<your-subdomain>.daily.co
DAILY_API_KEY=<daily-api-key>
VIDEO_PROVIDER=daily

# ── Twilio Verify (OTP) ──────────────────────
TWILIO_ACCOUNT_SID=AC<account-sid>
TWILIO_AUTH_TOKEN=<auth-token>
TWILIO_VERIFY_SERVICE_SID=VA<service-sid>

# ── Exotel (audio call + SMS fallback) ───────
EXOTEL_ACCOUNT_SID=<account-sid>
EXOTEL_API_KEY=<api-key>
EXOTEL_API_TOKEN=<api-token>
EXOTEL_CALLER_ID=<exotel-phone-number>
EXOTEL_SMS_FROM=CALDOC

# ── AWS S3 ───────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=<iam-access-key>
AWS_SECRET_ACCESS_KEY=<iam-secret-key>
AWS_S3_BUCKET=<bucket-name>

# ── Resend (transactional email) ─────────────
RESEND_API_KEY=re_<resend-key>
EMAIL_FROM=CalDoc <noreply@caldoc.in>

# ── Portal defaults (set strong passwords in Vercel) ─
PROVIDER_DASH_USER=admin
PROVIDER_DASH_PASS=<strong-password>
PROVIDER_DEFAULT_PASSWORD=<temp-password>
FRONTDESK_ALLOWED_EMAILS=frontdesk@caldoc.in
FRONTDESK_DEFAULT_PASSWORD=<temp-password>
PHARMACY_ALLOWED_EMAILS=
PHARMACY_PORTAL_DEFAULT_PASSWORD=<temp-password>
NGO_ALLOWED_EMAILS=
NGO_PORTAL_DEFAULT_PASSWORD=<temp-password>

# ── Notifications ─────────────────────────────
ADMIN_PHONE=+91<your-whatsapp-number>
NEXT_PUBLIC_RESCHEDULE_URL=https://caldoc.in/providers

# ── Session ──────────────────────────────────
PATIENT_MOBILE_JWT_MAX_AGE_DAYS=365
SESSION_COOKIE_DOMAIN=
PROXY_ENABLED=true
